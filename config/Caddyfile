# Lyra Web 0.4 — Caddy on the Lyra CT (LAN / Tailscale only, never port-forwarded).
#
# Static PWA from /var/www/lyra; /api/* and /ws proxied to Lyra API, which stays
# bound to 127.0.0.1:8787. Caddy keeps the original Host header, so the API's
# same-origin check accepts the page's own requests and rejects other sites.
#
# Two site blocks:
#  - plain HTTP on the LAN: everything works, but browsers only allow service
#    workers on HTTPS, so offline shell caching / full PWA install need the
#    second block.
#  - HTTPS via Tailscale (MagicDNS name, certificate from the local tailscaled).
#    Replace lyra-ct.example-tailnet.ts.net with the CT's real name and give the
#    caddy user access to tailscaled: TS_PERMIT_CERT_UID=caddy in
#    /etc/default/tailscaled, then `systemctl restart tailscaled`.

(lyra) {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}

	handle /ws {
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		root * /var/www/lyra
		try_files {path} /index.html
		file_server
	}

	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@fresh path /sw.js /index.html /manifest.webmanifest /
	header @fresh Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# No "log" directive on purpose: Caddy writes no access log unless asked,
	# and request paths contain personal searches (?q=...).
}

# LAN (and Tailscale IP) over plain HTTP on port 80.
:80 {
	import lyra
}

# Tailscale HTTPS (uncomment after setting the real MagicDNS name).
